{
  "name": "recosocial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:m1": "node --test tests/m1-auth.test.mjs tests/m1-save-counts.test.mjs tests/m1-media.test.mjs supabase/tests/m1-database.test.mjs",
    "test:m1:db": "node --test supabase/tests/m1-database.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "types:generate": "node scripts/generate-database-types.mjs",
    "types:check": "node scripts/generate-database-types.mjs --check",
    "test:m2": "node --test tests/m2-*.test.mjs supabase/tests/m2-publication.test.mjs",
    "test:m3": "node --test tests/m3-*.test.mjs",
    "test:m4": "node --test tests/m4-*.test.mjs",
    "test:m5": "node --test tests/m5-*.test.mjs",
    "test:m6": "node --test tests/m6-*.test.mjs supabase/tests/m6-*.test.mjs",
    "demo:plan": "node scripts/demo/cli.mjs plan",
    "demo:seed": "node scripts/demo/cli.mjs seed",
    "demo:reset": "node scripts/demo/cli.mjs reset",
    "demo:media": "node scripts/demo/generate-media.mjs",
    "test:demo": "node --test tests/m6-demo-*.test.mjs supabase/tests/m6-demo-seed.test.mjs",
    "test": "node --test tests/*.test.mjs supabase/tests/*.test.mjs",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "test:recommendations": "node --test tests/m1-save-counts.test.mjs tests/m3-feed.test.mjs tests/m3-discovery.test.mjs tests/m6-recommendations.test.mjs tests/m6-demo-recommendations.test.mjs supabase/tests/m6-recommendations.test.mjs",
    "bundle:measure": "node scripts/measure-client-bundle.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
